<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Provincias de <%= pais.pais_descripcion %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 text-primary fw-bold">📍 Provincias de: <%= pais.pais_descripcion %></h1>
                    <a href="/" class="btn btn-outline-secondary">← Volver a Países</a>
                </div>

                <% if (provincias.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-secondary">
                                <tr>
                                    <th style="width: 15%;">#</th>
                                    <th>Provincia / Entidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% provincias.forEach((prov, index) => { %>
                                    <tr>
                                        <td class="fw-bold"><%= index + 1 %></td>
                                        <td><%= prov.pro_descripcion %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="alert alert-warning text-center" role="alert">
                        <em>No hay provincias cargadas para este país.</em>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
</body>
</html>