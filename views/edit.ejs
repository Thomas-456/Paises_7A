<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar País</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; }
    </style>
</head>
<body>
    <h1>Editar País</h1>
    <form action="/actualizar/<%= pais.pais_id %>" method="POST">
        <input type="text" name="pais_descripcion" value="<%= pais.pais_descripcion %>" required>
        <button type="submit">Actualizar</button>
        <a href="/">Cancelar</a>
    </form>
</body>
</html>